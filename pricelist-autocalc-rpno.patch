+    const an = /^\d+$/.test(av), bn = /^\d+$/.test(bv);
+    if (an && bn) {
+      const diff = Number(av) - Number(bv);
+      if (diff !== 0) return diff;
+    } else {
+      const diff = av.localeCompare(bv);
+      if (diff !== 0) return diff;
+    }
+  }
+  return 0;
+}
 
