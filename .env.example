# Copy this file to .env and fill in your Supabase project details to
# switch the app from IndexedDB (offline, per-device) to Supabase (cloud,
# cross-device). Leave .env absent/empty to keep using IndexedDB.
#
# Find these in Supabase dashboard -> Project Settings -> API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
